# Never commit the real file (bridge/.env is git-ignored).

# Written by infra/webpubsub.ps1 -Apply.
WEBPUBSUB_CONNECTION_STRING=

# One GitHub token per account in config.json "github.accounts": GITHUB_TOKEN_<ACCOUNT>,
# upper case, with anything that is not a letter or digit turned into _.
# Classic token with the "repo" scope (see README). Only the bridge reads these;
# Claude never sees them.
GITHUB_TOKEN_YOURACCOUNT=
